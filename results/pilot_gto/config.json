  "eval_episodes": 2,
  "val_episodes": 1,
  "eval_interval": 20000,
  "per_agent": {},
  "agent_kwargs": {},
  "env": {},
  "exclude": [],
  "include_only": [],
  "allow_implausible": false,
  "report_policy": "best",
  "selection_metric": "return",
  "results_dir": "results",
